# Configuration for the public idea board and completion notices.
# The blank secrets are intentional; supply them in your private .env or deployment settings.
# The email guide is in docs/email-setup.md; development log mode works without provider credentials.

APP_URL=http://localhost:3000 # Address of the feature board, including scheme and port; omit any path.
HOST=127.0.0.1 # Bind the server here. The default accepts connections from this machine only.
PORT=3000 # Set the production listener port here; the dev server has its own configuration.
DB_PATH=.data/app.sqlite # Feature requests, completion state, and notification history; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Set a random 16+ character password to mark feature requests completed. Sign in as admin.
OWNER_EMAIL=owner@example.com # Not used for feature completion notices; this setting can be left empty.
REVIEWER_EMAIL=reviewer@example.com # Ignored by this workflow; feature completion notices do not use a configured reviewer.
MAIL_MODE=sandbox # For feature completion notices: sandbox for capture, production for real sending, log for local development.
MAIL_FROM=sender@example.com # Address sending feature completion notices; for production, choose one on your verified Mailtrap domain.
MAILTRAP_PRODUCTION_TOKEN= # Add your Mailtrap transactional token here to send feature completion notices in production.
MAILTRAP_SANDBOX_TOKEN= # For sandbox API calls, copy the token from your Mailtrap inbox integration settings.
MAILTRAP_INBOX_ID= # Inbox ID from Mailtrap Sandbox integration settings; captures feature completion notices during setup.
ORIGIN=http://localhost:3000 # SvelteKit origin for the feature-board form action; match APP_URL exactly.
BODY_SIZE_LIMIT=16384 # Maximum feature-request body in bytes; 16384 allows 16 KiB.
